{
  "id": "remote-mobile-control",
  "title": "Experimental Remote Mobile Control",
  "description": "Opt-in Linux adaptation for experimental Remote host and outbound-control flows.",
  "defaultEnabled": false,
  "gentoo": {
    "supported": true,
    "dependencies": {
      "RDEPEND": ["sys-apps/util-linux"]
    }
  },
  "entrypoints": {
    "patchDescriptors": "./patch.js",
    "stageHook": "./stage.sh"
  },
  "resources": [
    {
      "source": "cold-start-hook.sh",
      "target": ".codex-linux/cold-start.d/remote-mobile-control",
      "mode": "0755"
    }
  ]
}
